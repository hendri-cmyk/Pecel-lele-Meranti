    <!-- Application Logic Script -->
    <script>
        let cart = [];

        // Toggle Mobile Navigation
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Menu Filtering Logic
        function filterMenu(category) {
            const buttons = document.querySelectorAll('.category-btn');
            const items = document.querySelectorAll('.menu-card');

            buttons.forEach(btn => {
                if (btn.dataset.category === category) {
                    btn.classList.add('bg-brand-600', 'text-white', 'border-brand-500');
                    btn.classList.remove('bg-gray-900', 'text-gray-300', 'border-gray-800');
                } else {
                    btn.classList.remove('bg-brand-600', 'text-white', 'border-brand-500');
                    btn.classList.add('bg-gray-900', 'text-gray-300', 'border-gray-800');
                }
            });

            items.forEach(item => {
                if (category === 'all' || item.dataset.category === category) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Show Toast Notification
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            toastMsg.innerText = message;
            
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        }

        // Add Item to Cart
        function addToCart(name, price, img) {
            const existingIndex = cart.findIndex(item => item.name === name);
            if (existingIndex > -1) {
                cart[existingIndex].qty += 1;
            } else {
                cart.push({
                    name: name,
                    price: price,
                    img: img,
                    qty: 1
                });
            }
            updateCartUI();
            showToast(`'${name}' ditambahkan ke keranjang!`);
        }

        // Update Quantity
        function updateQty(index, change) {
            cart[index].qty += change;
            if (cart[index].qty <= 0) {
                cart.splice(index, 1);
            }
            updateCartUI();
        }

        // Update Cart Drawer UI & Badge
        function updateCartUI() {
            const cartItemsContainer = document.getElementById('cart-items');
            const cartBadge = document.getElementById('cart-badge');
            const cartSubtotal = document.getElementById('cart-subtotal');
            const cartTotal = document.getElementById('cart-total');

            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            cartBadge.innerText = totalCount;

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="text-center py-12 text-gray-400">
                        <i class="fa-solid fa-utensils text-4xl mb-3 opacity-40"></i>
                        <p class="text-sm font-medium">Keranjang kamu masih kosong.</p>
                        <p class="text-xs text-gray-400 mt-1">Pilih menu favoritmu di atas ya!</p>
                    </div>
                `;
            } else {
                cartItemsContainer.innerHTML = cart.map((item, index) => `
                    <div class="flex items-center justify-between gap-3 bg-gray-900 p-3 rounded-xl border border-gray-800">
                        <img src="${item.img}" alt="${item.name}" class="w-14 h-14 object-cover rounded-lg shrink-0">
                        <div class="flex-1 min-w-0">
                            <h5 class="text-xs font-bold text-white truncate">${item.name}</h5>
                            <p class="text-xs text-brand-500 font-extrabold mt-0.5">Rp ${item.price.toLocaleString('id-ID')}</p>
                        </div>
                        <div class="flex items-center gap-2 bg-gray-950 px-2 py-1 rounded-lg border border-gray-800">
                            <button onclick="updateQty(${index}, -1)" class="text-gray-400 hover:text-white text-xs px-1.5 py-0.5 font-bold">-</button>
                            <span class="text-xs font-bold text-white w-4 text-center">${item.qty}</span>
                            <button onclick="updateQty(${index}, 1)" class="text-gray-400 hover:text-white text-xs px-1.5 py-0.5 font-bold">+</button>
                        </div>
                    </div>
                `).join('');
            }

            cartSubtotal.innerText = `Rp ${totalPrice.toLocaleString('id-ID')}`;
            cartTotal.innerText = `Rp ${totalPrice.toLocaleString('id-ID')}`;
        }

        // Toggle Cart Drawer
        function toggleCart() {
            const drawer = document.getElementById('cart-drawer');
            const panel = document.getElementById('cart-panel');

            if (drawer.classList.contains('opacity-0')) {
                drawer.classList.remove('opacity-0', 'pointer-events-none');
                panel.classList.remove('translate-x-full');
            } else {
                panel.classList.add('translate-x-full');
                setTimeout(() => {
                    drawer.classList.add('opacity-0', 'pointer-events-none');
                }, 300);
            }
        }

        // WhatsApp Checkout Direct Link Generator
        function checkoutWhatsApp() {
            if (cart.length === 0) {
                showToast('Keranjang kamu masih kosong!');
                return;
            }

            const name = document.getElementById('customer-name').value.trim() || 'Pelanggan Pecel Lele Meranti';
            const type = document.getElementById('order-type').value;
            const notes = document.getElementById('order-notes').value.trim() || 'Tidak ada';

            let text = `Halo *Pecel Lele Meranti*, saya mau pesan:\n\n`;
            text += `👤 *Nama:* ${name}\n`;
            text += `📌 *Tipe:* ${type}\n`;
            text += `📝 *Catatan:* ${notes}\n\n`;
            text += `📋 *Daftar Pesanan:*\n`;

            let totalPrice = 0;
            cart.forEach((item, i) => {
                const sub = item.price * item.qty;
                totalPrice += sub;
                text += `${i + 1}. ${item.name} (${item.qty}x) = Rp ${sub.toLocaleString('id-ID')}\n`;
            });

            text += `\n💰 *Total Pembayaran:* Rp ${totalPrice.toLocaleString('id-ID')}\n\n`;
            text += `Mohon konfirmasi pesanan ya. Terima kasih! 🌶️`;

            const encodedText = encodeURIComponent(text);
            const waNumber = '6281234567890';
            window.open(`https://wa.me/${waNumber}?text=${encodedText}`, '_blank');
        }

        window.onload = function() {
            updateCartUI();

            // Initialize Interactive Map with Leaflet JS & Dark Tiles
            if (document.getElementById('map')) {
                const merantiCoords = [1.0118, 102.7078];
                
                const map = L.map('map', {
                    center: merantiCoords,
                    zoom: 16,
                    zoomControl: true,
                    scrollWheelZoom: false
                });

                // CartoDB Dark Matter Tile Layer
                L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
                    subdomains: 'abcd',
                    maxZoom: 19
                }).addTo(map);

                // Custom Map Pin Marker
                const customIcon = L.divIcon({
                    className: 'custom-map-pin',
                    html: `
                        <div class="relative flex items-center justify-center">
                            <span class="absolute w-8 h-8 bg-brand-600/50 rounded-full animate-ping"></span>
                            <div class="w-10 h-10 bg-gradient-to-br from-brand-600 to-amberbrand-500 rounded-full border-2 border-white flex items-center justify-center text-white shadow-xl">
                                <i class="fa-solid fa-fire-burner text-base"></i>
                            </div>
                        </div>
                    `,
                    iconSize: [40, 40],
                    iconAnchor: [20, 20],
                    popupAnchor: [0, -20]
                });

                const marker = L.marker(merantiCoords, { icon: customIcon }).addTo(map);
                
                marker.bindPopup(`
                    <div style="font-family: 'Plus Jakarta Sans', sans-serif; padding: 4px; color: #1e293b;">
